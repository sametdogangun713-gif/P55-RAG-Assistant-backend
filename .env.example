# Bu dosyayi ".env" adiyla kopyala ve kendi degerlerini yaz.
# .env dosyasi .gitignore'da, depoya YUKLENMEZ. Buraya gercek anahtar YAZMA.
# Bulutta (Vercel) .env dosyasi YOKTUR: ayni degiskenler Vercel -> Project -> Settings -> Environment Variables'a girilir.
# Bulut icin tum degerlerin listesi: docs/dagitim.md

# Yerel: SQLite dosyasi. Bulut: Supabase -> Connect -> "Transaction pooler" adresi (postgresql://...:6543/postgres)
DATABASE_URL=sqlite:///./data/p55.db
UPLOAD_DIR=./uploads

# Arayuzun (frontend) calistigi adresler; tarayici yalnizca bunlardan backend'e istek atabilir (CORS). Virgulle ayir.
# Bulutta ornek: https://p55-rag-assistant-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Oturum token'larini imzalamak icin gizli anahtar. Uret:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistir-bunu
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Yonetici hesabi scripts/create_admin.py ile olusturulur (kendi kendine kayitla yonetici olunmaz)

# Belge yukleme ve parcalama. Bulutta 50 (Supabase ucretsiz planinda dosya basina sinir)
MAX_UPLOAD_MB=500
# Belge basina en fazla parca (metin miktari siniri; ~20 000 parca = ~5 000 sayfa metin)
MAX_CHUNKS_PER_DOCUMENT=20000
# Bir istekte en fazla kac saniye indekslenir. Bos = varsayilan: yerelde 0 (sinirsiz), Vercel'de 60.
# Buyuk belge birden cok istekte, kaldigi yerden devam ederek indekslenir (arayuz yuzdeyi gosterir).
INDEX_BUDGET_SECONDS=
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Embedding. "local" = sentence-transformers (kendi bilgisayarinda, ucretsiz),
# "hf" = Hugging Face sunucusunda BAAI/bge-m3 (bulut/Vercel), "hash" = indirme gerektirmeyen basit yedek (testler)
EMBEDDING_BACKEND=local
# Bos = varsayilan: local -> paraphrase-multilingual-MiniLM-L12-v2, hf -> BAAI/bge-m3
EMBEDDING_MODEL=
SEARCH_TOP_K=5
# "hf" icin: https://huggingface.co/settings/tokens -> "Make calls to Inference Providers" izinli token.
# BURAYA DEGIL, sadece .env dosyasina / Vercel paneline yaz.
HF_TOKEN=

# Dosya deposu: "local" = sunucu diski, "supabase" = Supabase Storage (bulutta zorunlu; Vercel istegi en fazla 4,5 MB)
STORAGE_BACKEND=local
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> "service_role" / "secret". HER SEYE erisir: yalnizca backend'de dursun.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=belgeler

# Yanit ureten saglayici: "claude" (ucretli) ya da "groq" (ucretsiz katmani var)
LLM_PROVIDER=claude

# Groq API (OpenAI uyumlu). Anahtari https://console.groq.com/keys adresinden al; BURAYA DEGIL, sadece .env dosyasina yaz.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Dusunen modellerde dusunme miktari (low|medium|high). Dusunmeyen bir model secersen bos birak.
GROQ_REASONING_EFFORT=medium

# Claude API (yanit uretimi). Anahtari https://console.anthropic.com adresinden al; BURAYA DEGIL, sadece .env dosyasina yaz.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=800

# RAG (kaynakli yanit)
RAG_TOP_K=4
# Bu skorun altindaki parcalar "ilgisiz" sayilir. Bos = varsayilan: local 0.30, hf (bge-m3) 0.40, hash 0.15.
# Kendi olcumune gore ayarla (belgede olan/olmayan sorularin en yuksek skorlarina bak).
MIN_SCORE=
# Sohbette belgelerde yanit yoksa genel bilgiyle (etiketli, kaynaksiz) yanit: 1 = acik, 0 = yalnizca belgeler
GENERAL_CHAT=1

# Sohbet baglami
CHAT_HISTORY_CHARS=4000
CHAT_KEEP_RECENT=6

# Calisma ortami: "production" iken zayif SECRET_KEY ile uygulama baslamaz
APP_ENV=development
MAX_DOCX_UNCOMPRESSED_MB=1024

# E-posta: kayitta dogrulama kodu ve "Sifremi unuttum" sifirlama kodu bununla gider. Bos birakilirsa:
# development'ta kod sunucu penceresine yazilir; production'da kayit ve sifirlama 503 doner (kod ulastirilamaz).
# Gmail icin: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=gmail adresin, SMTP_PASSWORD=Google hesabinda 2 adimli dogrulamayi acip
# https://myaccount.google.com/apppasswords adresinden urettigin 16 haneli "uygulama sifresi" (hesap parolan DEGIL).
# Gercek degerleri BURAYA DEGIL, sadece .env dosyasina yaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESET_CODE_MINUTES=15
# Kayit olan kisi e-postasindaki kodu girmeden giris yapamaz (1 = acik, 0 = kapali: hesap hemen dogrulanmis sayilir)
REQUIRE_EMAIL_VERIFICATION=1
VERIFY_CODE_MINUTES=30
